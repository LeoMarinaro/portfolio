# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection with pooling, used by the app (e.g. Neon "pooled" URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# Direct connection without pooling, used by Prisma migrations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# Optional: GitHub fine-grained token with public read-only access.
# Raises the GitHub API limit from 60 to 5,000 requests per hour.
GITHUB_TOKEN=""
